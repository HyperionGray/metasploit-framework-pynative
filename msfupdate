#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
Metasploit Framework Update Tool - Python Native Version

This script updates the Metasploit Framework to the latest version.
Pure Python implementation converted from the original Ruby msfupdate script.
"""

import sys
import argparse
import subprocess
import os
from pathlib import Path


def main():
    """Main entry point for msfupdate."""
    
    msf_root = Path(__file__).parent.resolve()
    
    parser = argparse.ArgumentParser(
        prog='msfupdate',
        description='Metasploit Framework Updater - Python-native implementation',
        epilog='Keep your framework up-to-date.'
    )
    
    parser.add_argument('--git-branch', 
                       help='Git branch to update to')
    parser.add_argument('--git-remote',
                       help='Git remote to update from')
    parser.add_argument('--offline-file',
                       help='Path to offline update file')
    parser.add_argument('mode', nargs='?', choices=['wait', 'nowait'],
                       help='Wait for user input after update')
    parser.add_argument('-q', '--quiet', action='store_true',
                       help='Suppress banner output')
    
    args = parser.parse_args()
    
    if not args.quiet:
        print("=" * 70)
        print("  Metasploit Framework Updater - Python-Native")
        print("=" * 70)
        print()
    
    # Check if this is a git repository
    git_dir = msf_root / ".git"
    
    if not git_dir.exists():
        print("This installation does not appear to be a git repository.")
        print("Cannot update using git.")
        print()
        print("To update, either:")
        print("  1. Clone from git: git clone https://github.com/HyperionGray/metasploit-framework-pynative.git")
        print("  2. Use system package manager")
        print("  3. Download and install manually")
        return 1
    
    print("🐍 Python-native framework updater")
    print(f"Framework location: {msf_root}")
    print()
    
    # Get current branch
    try:
        result = subprocess.run(['git', 'rev-parse', '--abbrev-ref', 'HEAD'],
                              cwd=msf_root, capture_output=True, text=True, check=True)
        current_branch = result.stdout.strip()
        print(f"Current branch: {current_branch}")
    except subprocess.CalledProcessError:
        print("Could not determine current branch")
        current_branch = None
    
    # Determine target branch
    target_branch = args.git_branch or current_branch or 'main'
    remote = args.git_remote or 'origin'
    
    print(f"Target branch: {target_branch}")
    print(f"Remote: {remote}")
    print()
    
    # Check for local changes
    try:
        result = subprocess.run(['git', 'status', '--porcelain'],
                              cwd=msf_root, capture_output=True, text=True, check=True)
        if result.stdout.strip():
            print("⚠️  Warning: Local changes detected")
            print("You may want to commit or stash changes before updating.")
            print()
    except subprocess.CalledProcessError:
        pass
    
    # Perform update
    print("Fetching updates...")
    try:
        subprocess.run(['git', 'fetch', remote], cwd=msf_root, check=True)
        print("✅ Fetch complete")
    except subprocess.CalledProcessError as e:
        print(f"❌ Fetch failed: {e}")
        return 1
    
    print(f"Pulling changes from {remote}/{target_branch}...")
    try:
        subprocess.run(['git', 'pull', remote, target_branch], cwd=msf_root, check=True)
        print("✅ Update complete")
    except subprocess.CalledProcessError as e:
        print(f"❌ Pull failed: {e}")
        return 1
    
    print()
    print("Framework updated successfully!")
    print("Run 'pip3 install -r requirements.txt' to update Python dependencies.")
    
    if args.mode == 'wait':
        print()
        input("Press Enter to continue...")
    
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nAborting...")
        sys.exit(1)
