#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
Metasploit Framework Update Tool - Python Native Version

This script updates the Metasploit Framework to the latest version.

Pure Python implementation.
"""

import sys
import os
import argparse
import subprocess
from pathlib import Path


def main():
    """Main entry point for msfupdate."""
    
    parser = argparse.ArgumentParser(
        description='Metasploit Framework Update Tool - Python Native Version'
    )
    parser.add_argument('--git-remote', default='origin',
                       help='Git remote to use (default: origin)')
    parser.add_argument('--git-branch', default='main',
                       help='Git branch to use (default: main)')
    parser.add_argument('-q', '--quiet', action='store_true',
                       help='Quiet mode')
    
    args = parser.parse_args()
    
    # Show informational message
    if not args.quiet:
        print("\n" + "="*70)
        print("  Metasploit Framework Update Tool - Python Native Version")
        print("="*70)
        print("  Pure Python implementation - no Ruby dependencies")
        print("="*70 + "\n")
    
    # Get the framework root
    framework_root = Path(__file__).parent.resolve()
    
    print("[*] Checking for updates...")
    print(f"[*] Framework root: {framework_root}")
    
    # Check if we're in a git repository
    if not (framework_root / ".git").exists():
        print("[!] Error: Not a git repository")
        print("[!] Please install from git or use a package manager")
        sys.exit(1)
    
    try:
        # Fetch updates
        print(f"[*] Fetching updates from {args.git_remote}/{args.git_branch}...")
        result = subprocess.run(
            ["git", "fetch", args.git_remote],
            cwd=framework_root,
            capture_output=True,
            text=True
        )
        
        if result.returncode != 0:
            print(f"[!] Error fetching updates: {result.stderr}")
            sys.exit(1)
        
        # Check if updates are available
        result = subprocess.run(
            ["git", "rev-list", f"HEAD..{args.git_remote}/{args.git_branch}", "--count"],
            cwd=framework_root,
            capture_output=True,
            text=True
        )
        
        if result.returncode == 0:
            commits_behind = int(result.stdout.strip())
            if commits_behind > 0:
                print(f"[*] {commits_behind} commit(s) available for update")
                
                # Pull updates
                print(f"[*] Pulling updates from {args.git_remote}/{args.git_branch}...")
                result = subprocess.run(
                    ["git", "pull", args.git_remote, args.git_branch],
                    cwd=framework_root
                )
                
                if result.returncode == 0:
                    print("[+] Update successful!")
                    
                    # Update Python dependencies
                    print("[*] Updating Python dependencies...")
                    requirements_file = framework_root / "requirements.txt"
                    if requirements_file.exists():
                        subprocess.run([sys.executable, "-m", "pip", "install", "-r", str(requirements_file)])
                    
                    print("[+] Framework updated successfully!")
                else:
                    print("[!] Error pulling updates")
                    sys.exit(1)
            else:
                print("[+] Framework is already up to date!")
        
    except Exception as e:
        print(f"[!] Error during update: {e}")
        sys.exit(1)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nAborting...")
        sys.exit(1)
